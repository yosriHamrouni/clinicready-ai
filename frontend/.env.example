# Base URL of the API as seen by the browser. Same-origin by default (nginx / Vite proxy).
VITE_API_BASE_URL=/api/v1

# Set to true to run against MSW mocks (no backend needed).
VITE_USE_MOCKS=false

# Dev only: show the StatusBadge variants strip on the dashboard.
VITE_SHOW_DESIGN_DEMO=false

# Dev server only: where Vite proxies /api (local backend without Docker).
# VITE_DEV_API_TARGET=http://localhost:8080
