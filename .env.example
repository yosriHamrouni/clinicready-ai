# Copy to .env and adjust. Never commit .env.

POSTGRES_DB=clinicready
POSTGRES_USER=clinicready
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
API_PORT=8080

# Required. At least 32 bytes. Generate one with: openssl rand -base64 48
JWT_SECRET=

# Largest accepted document upload (PDF/JPEG/PNG).
# DOCUMENTS_MAX_SIZE=10MB

# Added in M4
# LLM_PROVIDER=
# LLM_API_KEY=

# Frontend (host port for the nginx container)
FRONTEND_PORT=3000
