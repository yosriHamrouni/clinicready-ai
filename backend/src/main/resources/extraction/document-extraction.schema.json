{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DocumentExtraction",
  "description": "What a model may report about one document. null means the value could not be identified.",
  "type": "object",
  "additionalProperties": false,
  "required": ["category", "documentDate", "issuer", "confidence"],
  "properties": {
    "category": {
      "enum": ["ID_DOCUMENT", "INSURANCE_CARD", "PRESCRIPTION", "REFERRAL_LETTER", "CONSENT_FORM",
               "LAB_RESULT", "IMAGING_REPORT", "OTHER", null]
    },
    "documentDate": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "issuer": {
      "type": ["string", "null"],
      "maxLength": 200
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
